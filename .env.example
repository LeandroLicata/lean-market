# Copiar a .env y completar. El .env real no se commitea.

# PostgreSQL. En Supabase: Project Settings → Database → Connection string.
DATABASE_URL="postgresql://usuario:contraseña@host:5432/basededatos"

# Firma las sesiones de NextAuth. Generar uno con: openssl rand -base64 32
NEXTAUTH_SECRET=""

# URL pública de la app. En desarrollo NextAuth la infiere, pero en producción
# es obligatoria: sin ella los redirects del login apuntan al lugar equivocado.
NEXTAUTH_URL="http://localhost:3000"
